<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nodig voor "Foto's alleen via wifi" -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Nodig om een update (APK van de eigen GitHub-releases) te laten installeren -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ZfApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_app_e"
        android:roundIcon="@mipmap/ic_app_e"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zeilersforum">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Zeilersforum.Starting"
            android:windowSoftInputMode="adjustResize">
            <!-- De ingang in de app-lijst loopt via de activity-aliases hieronder (instelbaar icoon). -->
            <!-- Links naar onderwerpen op zeilersforum.nl openen in de app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="zeilersforum.nl" />
                <data android:host="www.zeilersforum.nl" />
                <data android:pathPrefix="/index.php/forum-" />
            </intent-filter>
        </activity>

        <!-- Instelbaar app-icoon: precies één van deze aliases staat aan (zie ui/AppIcons.kt).
             De namen nooit veranderen: Android onthoudt per naam of hij aan of uit staat. -->
        <activity-alias
            android:name=".IconE"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_app_e"
            android:roundIcon="@mipmap/ic_app_e">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconA"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_app_a"
            android:roundIcon="@mipmap/ic_app_a">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconB"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_app_b"
            android:roundIcon="@mipmap/ic_app_b">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconC"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
